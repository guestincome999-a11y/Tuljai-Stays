{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "assets": [
      {
        "include": "assets/**/*",
        "outDir": "dist/backend/src"
      },
      {
        "include": "modules/operations/report-assets/**/*",
        "outDir": "dist/backend/src"
      }
    ]
  }
}
