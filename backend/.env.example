NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://127.0.0.1:8083,http://10.116.209.138:8083
API_BODY_LIMIT_BYTES=1048576

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tuljai_stays?schema=public

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=180d
AUTH_SESSION_MAX_AGE_DAYS=180

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_SECONDS=900
OTP_RATE_LIMIT_MAX_REQUESTS=5
ALLOW_DEV_OTP_RESPONSE=false # Set true only for temporary preview testing; disable before production launch

BOOKING_LOCK_TTL_SECONDS=300
BOOKING_OWNER_RESPONSE_DEADLINE_SECONDS=120
BOOKING_COMMISSION_FLAT_AMOUNT=
BOOKING_SCHEDULER_INTERVAL_SECONDS=60
BOOKING_QR_TOKEN_TTL_SECONDS=86400
BOOKING_SHOW_OWNER_PHONE_AFTER_ACCEPTED=false

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=tuljai-stays

OWNER_PASSWORD_RESET_TTL_SECONDS=1800
OWNER_PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900
OWNER_PASSWORD_RESET_RATE_LIMIT_MAX_REQUESTS=3
OWNER_PASSWORD_RESET_DEEP_LINK=tuljaistays-owner://reset-password

# Used to email owner-app password reset links. If left unset, reset tokens are still
# created but no email is sent (a warning is logged) — set these before relying on
# self-service "Forgot password" in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Tuljai Stays <tuljaistays@gmail.com>

# Separate from the API key secret. Configure in Razorpay Dashboard only after sandbox verification.
# Endpoint: POST /api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=
# Booking confirmation email (backend only; disabled until controlled-recipient test).
EMAIL_PROVIDER=gmail
EMAIL_FROM_NAME=Tuljai Stays
# EMAIL_FROM_ADDRESS=your-sender-address
# EMAIL_SUPPORT_ADDRESS=your-support-address
BOOKING_EMAIL_ENABLED=false
# During validation, allow only your controlled mailbox. Never redirect guest mail to a tester.
BOOKING_EMAIL_ALLOWED_RECIPIENTS=
# Gmail API over HTTPS (works without SMTP ports on Render). Store these only as backend secrets.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# Optional existing HTTPS booking route; {bookingId} is substituted. Leave unset without a supported route.
# BOOKING_WEB_URL_TEMPLATE=https://your-existing-booking-route/{bookingId}
# Enable for in-app passes after updated owner scanner deployment. Email passes always use encrypted v2.
BOOKING_QR_OPAQUE_ENABLED=false
