JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_SECONDS=900
OTP_RATE_LIMIT_MAX_REQUESTS=5
ALLOW_DEV_OTP_RESPONSE=false # Set true only for temporary preview testing; disable before production launch

BOOKING_LOCK_TTL_SECONDS=300
BOOKING_OWNER_RESPONSE_DEADLINE_SECONDS=120
BOOKING_COMMISSION_FLAT_AMOUNT=
BOOKING_SCHEDULER_INTERVAL_SECONDS=60
BOOKING_QR_TOKEN_TTL_SECONDS=86400
BOOKING_SHOW_OWNER_PHONE_AFTER_ACCEPTED=false

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
