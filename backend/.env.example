NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://127.0.0.1:8083,http://10.116.209.138:8083
API_BODY_LIMIT_BYTES=1048576

