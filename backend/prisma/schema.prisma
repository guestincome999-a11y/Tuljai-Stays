generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PILGRIM
  OWNER
  ADMIN
  SUPER_ADMIN
}

enum OtpPurpose {
  LOGIN
  REGISTER
  VERIFY_PHONE
}

enum AppType {
  PILGRIM_APP
  OWNER_APP
  ADMIN_PANEL
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
  UNKNOWN
}

enum PropertyType {
  LODGE
  BHAKT_NIWAS
  DHARAMSHALA
  HOTEL
  HOMESTAY
}

enum LodgeStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
  REJECTED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum LodgeDocumentType {
  OWNER_ID
  PAN
  GST
  BUSINESS_LICENSE
  PROPERTY_PROOF
  BANK_PROOF
  OTHER
}

enum AmenityCategory {
  ROOM
  PROPERTY
  SAFETY
  FAMILY
  PARKING
  FOOD
  ACCESSIBILITY
}

enum RoomStatus {
  AVAILABLE
  RESERVED
  PENDING_APPROVAL
  CONFIRMED
  OCCUPIED
  CLEANING
  MAINTENANCE
  BLOCKED
}

enum PriceType {
  NORMAL
  WEEKEND
  FESTIVAL
  MANUAL_OVERRIDE
}

enum PhotoCategory {
  COVER
  EXTERIOR
  RECEPTION
  ROOM
  BATHROOM
  PARKING
  AMENITY
  OTHER
}

enum PhotoApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  DRAFT
  PENDING_OWNER_APPROVAL
  ACCEPTED
  REJECTED
  QR_GENERATED
  CHECKED_IN
  CHECKED_OUT
  COMPLETED
  CANCELLED
  EXPIRED
  NO_SHOW
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  ADVANCE_PAID
  FULLY_PAID
  PAY_AT_LODGE
  REFUNDED
  FAILED
}

enum GuestIdType {
  AADHAAR
  PAN
  VOTER_ID
  PASSPORT
  DRIVING_LICENSE
  OTHER
}

enum BookingLockStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  RELEASED
}

enum QrTokenStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum QrScanResult {
  SUCCESS
  INVALID
  EXPIRED
  USED
  UNAUTHORIZED
  BOOKING_NOT_FOUND
  WRONG_LODGE
  INVALID_STATUS
}

enum GuestRegisterStatus {
  CHECKED_IN
  CHECKED_OUT
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum NotificationType {
  BOOKING_REQUEST
  BOOKING_ACCEPTED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  QR_GENERATED
  CHECKIN_COMPLETED
  CHECKOUT_COMPLETED
  CHECKOUT_REMINDER
  PHOTO_APPROVED
  PHOTO_REJECTED
  ADMIN_ANNOUNCEMENT
  EMERGENCY_ALERT
  REVIEW_RECEIVED
  SYSTEM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationChannel {
  IN_APP
  PUSH
  SOCKET
  EMAIL_OPTIONAL
  WHATSAPP_OPTIONAL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

enum AnnouncementCategory {
  GENERAL
  EMERGENCY
  TEMPLE_NOTICE
  FESTIVAL
  MAINTENANCE
  OFFER
  SYSTEM
}

enum AnnouncementTargetAudience {
  ALL
  PILGRIMS
  OWNERS
  ADMINS
  LODGE_SPECIFIC
  CITY_SPECIFIC
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
  REPORTED
}

enum ReviewReportReason {
  FAKE
  ABUSIVE
  MISLEADING
  SPAM
  OTHER
}

enum ReviewReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

model User {
  id                       String                    @id @default(uuid()) @db.Uuid
  phoneNumber              String                    @unique @map("phone_number")
  displayName              String?                   @map("display_name")
  roles                    UserRole[]                @default([PILGRIM])
  isActive                 Boolean                   @default(true) @map("is_active")
  lastLoginAt              DateTime?                 @map("last_login_at")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  deletedAt                DateTime?                 @map("deleted_at")
  auditLogs                AuditLog[]
  refreshTokens            RefreshToken[]
  sessions                 UserSession[]
  deviceTokens             DeviceToken[]
  ownedLodges              LodgeOwner[]
  ownedListings            Lodge[]                   @relation("PrimaryLodgeOwner")
  uploadedDocs             LodgeDocument[]           @relation("UploadedLodgeDocuments")
  reviewedDocs             LodgeDocument[]           @relation("ReviewedLodgeDocuments")
  reviewedLogs             LodgeVerificationLog[]
  uploadedPhotos           LodgePhoto[]              @relation("UploadedLodgePhotos")
  approvedPhotos           LodgePhoto[]              @relation("ApprovedLodgePhotos")
  pilgrimBookings          Booking[]                 @relation("PilgrimBookings")
  acceptedBookings         Booking[]                 @relation("AcceptedBookings")
  rejectedBookings         Booking[]                 @relation("RejectedBookings")
  bookingLocks             BookingLock[]
  bookingHistory           BookingHistory[]
  roomStatusHistory        RoomStatusHistory[]
  usedQrTokens             BookingQrToken[]          @relation("UsedQrTokens")
  qrScanLogs               QrScanLog[]               @relation("ScannedQrLogs")
  createdRegisters         GuestRegister[]           @relation("CreatedGuestRegisters")
  updatedRegisters         GuestRegister[]           @relation("UpdatedGuestRegisters")
  verifiedGuestIdDocuments GuestIdDocument[]         @relation("VerifiedGuestIdDocuments")
  registerAuditLogs        RegisterAuditLog[]
  notifications            Notification[]
  notificationDeliveryLogs NotificationDeliveryLog[]
  announcementsCreated     Announcement[]            @relation("CreatedAnnouncements")
  announcementReads        AnnouncementRead[]
  notificationPreferences  NotificationPreference[]
  reviews                  Review[]                  @relation("PilgrimReviews")
  reviewReports            ReviewReport[]            @relation("ReportedReviews")
  reviewedReviewReports    ReviewReport[]            @relation("ReviewedReviewReports")

  @@index([phoneNumber])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

model City {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  slug           String           @unique
  state          String
  country        String
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")
  lodges         Lodge[]
  bookings       Booking[]
  announcements  Announcement[]
  analyticsDaily AnalyticsDaily[]

  @@index([slug])
  @@index([isActive])
  @@index([deletedAt])
  @@map("cities")
}

model Lodge {
  id                       String                 @id @default(uuid()) @db.Uuid
  cityId                   String                 @map("city_id") @db.Uuid
  name                     String
  slug                     String
  description              String?
  propertyType             PropertyType           @map("property_type")
  status                   LodgeStatus            @default(DRAFT)
  verificationStatus       VerificationStatus     @default(PENDING) @map("verification_status")
  ownerUserId              String?                @map("owner_user_id") @db.Uuid
  primaryPhone             String                 @map("primary_phone")
  secondaryPhone           String?                @map("secondary_phone")
  whatsappNumber           String?                @map("whatsapp_number")
  email                    String?
  distanceFromTempleMeters Int?                   @map("distance_from_temple_meters")
  latitude                 Decimal?               @db.Decimal(10, 7)
  longitude                Decimal?               @db.Decimal(10, 7)
  checkInTime              String?                @map("check_in_time")
  checkOutTime             String?                @map("check_out_time")
  rules                    String?
  isActive                 Boolean                @default(true) @map("is_active")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")
  deletedAt                DateTime?              @map("deleted_at")
  city                     City                   @relation(fields: [cityId], references: [id])
  ownerUser                User?                  @relation("PrimaryLodgeOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  address                  LodgeAddress?
  owners                   LodgeOwner[]
  documents                LodgeDocument[]
  verificationLogs         LodgeVerificationLog[]
  amenities                LodgeAmenity[]
  roomTypes                RoomType[]
  rooms                    Room[]
  photos                   LodgePhoto[]
  bookings                 Booking[]
  bookingLocks             BookingLock[]
  qrScanLogs               QrScanLog[]
  guestRegisters           GuestRegister[]
  notifications            Notification[]
  announcements            Announcement[]
  reviews                  Review[]
  analyticsDaily           AnalyticsDaily[]

  @@unique([cityId, slug])
  @@index([cityId])
  @@index([ownerUserId])
  @@index([status, verificationStatus, isActive])
  @@index([deletedAt])
  @@map("lodges")
}

model LodgeAddress {
  id           String   @id @default(uuid()) @db.Uuid
  lodgeId      String   @unique @map("lodge_id") @db.Uuid
  addressLine1 String   @map("address_line_1")
  addressLine2 String?  @map("address_line_2")
  landmark     String?
  city         String
  district     String
  state        String
  pincode      String
  country      String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  lodge        Lodge    @relation(fields: [lodgeId], references: [id], onDelete: Cascade)

  @@map("lodge_addresses")
}

model LodgeOwner {
  id         String    @id @default(uuid()) @db.Uuid
  lodgeId    String    @map("lodge_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  ownerName  String    @map("owner_name")
  ownerPhone String    @map("owner_phone")
  ownerEmail String?   @map("owner_email")
  roleTitle  String?   @map("role_title")
  isPrimary  Boolean   @default(false) @map("is_primary")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  lodge      Lodge     @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lodgeId, userId])
  @@index([lodgeId, isPrimary])
  @@index([userId])
  @@index([deletedAt])
  @@map("lodge_owners")
}

model LodgeDocument {
  id                 String             @id @default(uuid()) @db.Uuid
  lodgeId            String             @map("lodge_id") @db.Uuid
  documentType       LodgeDocumentType  @map("document_type")
  documentNumber     String?            @map("document_number")
  fileUrl            String?            @map("file_url")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  uploadedByUserId   String             @map("uploaded_by_user_id") @db.Uuid
  reviewedByUserId   String?            @map("reviewed_by_user_id") @db.Uuid
  reviewedAt         DateTime?          @map("reviewed_at")
  rejectionReason    String?            @map("rejection_reason")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")
  lodge              Lodge              @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  uploadedBy         User               @relation("UploadedLodgeDocuments", fields: [uploadedByUserId], references: [id])
  reviewedBy         User?              @relation("ReviewedLodgeDocuments", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([lodgeId])
  @@index([verificationStatus])
  @@index([deletedAt])
  @@map("lodge_documents")
}

model LodgeVerificationLog {
  id               String             @id @default(uuid()) @db.Uuid
  lodgeId          String             @map("lodge_id") @db.Uuid
  status           VerificationStatus
  notes            String?
  reviewedByUserId String             @map("reviewed_by_user_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  lodge            Lodge              @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  reviewedBy       User               @relation(fields: [reviewedByUserId], references: [id])

  @@index([lodgeId])
  @@index([reviewedByUserId])
  @@map("lodge_verification_logs")
}

model Amenity {
  id        String          @id @default(uuid()) @db.Uuid
  name      String
  slug      String          @unique
  iconName  String?         @map("icon_name")
  category  AmenityCategory
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  deletedAt DateTime?       @map("deleted_at")
  lodges    LodgeAmenity[]

  @@index([category])
  @@index([isActive])
  @@index([deletedAt])
  @@map("amenities")
}

model LodgeAmenity {
  id        String   @id @default(uuid()) @db.Uuid
  lodgeId   String   @map("lodge_id") @db.Uuid
  amenityId String   @map("amenity_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  lodge     Lodge    @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  amenity   Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([lodgeId, amenityId])
  @@index([amenityId])
  @@map("lodge_amenities")
}

model RoomType {
  id               String          @id @default(uuid()) @db.Uuid
  lodgeId          String          @map("lodge_id") @db.Uuid
  name             String
  slug             String
  description      String?
  capacityAdults   Int             @map("capacity_adults")
  capacityChildren Int             @map("capacity_children")
  basePrice        Decimal         @map("base_price") @db.Decimal(10, 2)
  festivalPrice    Decimal?        @map("festival_price") @db.Decimal(10, 2)
  totalRooms       Int             @map("total_rooms")
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  deletedAt        DateTime?       @map("deleted_at")
  lodge            Lodge           @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  rooms            Room[]
  pricing          RoomPricing[]
  photos           LodgePhoto[]
  bookings         Booking[]
  bookingLocks     BookingLock[]
  guestRegisters   GuestRegister[]
  reviews          Review[]

  @@unique([lodgeId, slug])
  @@index([lodgeId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("room_types")
}

model Room {
  id             String              @id @default(uuid()) @db.Uuid
  lodgeId        String              @map("lodge_id") @db.Uuid
  roomTypeId     String              @map("room_type_id") @db.Uuid
  roomNumber     String              @map("room_number")
  floor          String?
  status         RoomStatus          @default(AVAILABLE)
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  deletedAt      DateTime?           @map("deleted_at")
  lodge          Lodge               @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  roomType       RoomType            @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  availability   RoomAvailability[]
  photos         LodgePhoto[]
  bookings       Booking[]
  bookingLocks   BookingLock[]
  statusHistory  RoomStatusHistory[]
  guestRegisters GuestRegister[]

  @@unique([lodgeId, roomNumber])
  @@index([roomTypeId])
  @@index([status])
  @@index([deletedAt])
  @@map("rooms")
}

model RoomPricing {
  id         String    @id @default(uuid()) @db.Uuid
  roomTypeId String    @map("room_type_id") @db.Uuid
  date       DateTime  @db.Date
  price      Decimal   @db.Decimal(10, 2)
  priceType  PriceType @map("price_type")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  roomType   RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
  @@index([date])
  @@map("room_pricing")
}

model RoomAvailability {
  id        String     @id @default(uuid()) @db.Uuid
  roomId    String     @map("room_id") @db.Uuid
  date      DateTime   @db.Date
  status    RoomStatus
  reason    String?
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  room      Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, date])
  @@index([date])
  @@index([status])
  @@map("room_availability")
}

model LodgePhoto {
  id               String              @id @default(uuid()) @db.Uuid
  lodgeId          String              @map("lodge_id") @db.Uuid
  roomTypeId       String?             @map("room_type_id") @db.Uuid
  roomId           String?             @map("room_id") @db.Uuid
  uploadedByUserId String              @map("uploaded_by_user_id") @db.Uuid
  category         PhotoCategory
  fileUrl          String              @map("file_url")
  thumbnailUrl     String?             @map("thumbnail_url")
  approvalStatus   PhotoApprovalStatus @default(PENDING) @map("approval_status")
  rejectionReason  String?             @map("rejection_reason")
  approvedByUserId String?             @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?           @map("approved_at")
  sortOrder        Int                 @default(0) @map("sort_order")
  isCover          Boolean             @default(false) @map("is_cover")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  deletedAt        DateTime?           @map("deleted_at")
  lodge            Lodge               @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  roomType         RoomType?           @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  room             Room?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  uploadedBy       User                @relation("UploadedLodgePhotos", fields: [uploadedByUserId], references: [id])
  approvedBy       User?               @relation("ApprovedLodgePhotos", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([lodgeId])
  @@index([roomTypeId])
  @@index([roomId])
  @@index([approvalStatus])
  @@index([deletedAt])
  @@map("lodge_photos")
}

model Booking {
  id                    String              @id @default(uuid()) @db.Uuid
  bookingCode           String              @unique @map("booking_code")
  pilgrimUserId         String              @map("pilgrim_user_id") @db.Uuid
  lodgeId               String              @map("lodge_id") @db.Uuid
  roomTypeId            String              @map("room_type_id") @db.Uuid
  roomId                String?             @map("room_id") @db.Uuid
  cityId                String              @map("city_id") @db.Uuid
  status                BookingStatus       @default(PENDING_OWNER_APPROVAL)
  guestName             String              @map("guest_name")
  guestPhone            String              @map("guest_phone")
  alternatePhone        String?             @map("alternate_phone")
  guestEmail            String?             @map("guest_email")
  guestAddress          String?             @map("guest_address")
  numberOfAdults        Int                 @map("number_of_adults")
  numberOfChildren      Int                 @map("number_of_children")
  totalGuests           Int                 @map("total_guests")
  checkInDate           DateTime            @map("check_in_date") @db.Date
  checkOutDate          DateTime            @map("check_out_date") @db.Date
  checkoutDateFlexible  Boolean             @default(false) @map("checkout_date_flexible")
  expectedCheckInTime   String?             @map("expected_check_in_time")
  expectedCheckOutTime  String?             @map("expected_check_out_time")
  specialRequest        String?             @map("special_request")
  totalAmount           Decimal?            @map("total_amount") @db.Decimal(10, 2)
  advanceAmount         Decimal?            @map("advance_amount") @db.Decimal(10, 2)
  balanceAmount         Decimal?            @map("balance_amount") @db.Decimal(10, 2)
  commissionAmount      Decimal?            @map("commission_amount") @db.Decimal(10, 2)
  paymentStatus         PaymentStatus       @default(PAY_AT_LODGE) @map("payment_status")
  ownerResponseDeadline DateTime?           @map("owner_response_deadline")
  acceptedByUserId      String?             @map("accepted_by_user_id") @db.Uuid
  rejectedByUserId      String?             @map("rejected_by_user_id") @db.Uuid
  cancellationReason    String?             @map("cancellation_reason")
  rejectedReason        String?             @map("rejected_reason")
  checkedInAt           DateTime?           @map("checked_in_at")
  checkedOutAt          DateTime?           @map("checked_out_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  deletedAt             DateTime?           @map("deleted_at")
  pilgrim               User                @relation("PilgrimBookings", fields: [pilgrimUserId], references: [id])
  lodge                 Lodge               @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  roomType              RoomType            @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  room                  Room?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  city                  City                @relation(fields: [cityId], references: [id])
  acceptedBy            User?               @relation("AcceptedBookings", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  rejectedBy            User?               @relation("RejectedBookings", fields: [rejectedByUserId], references: [id], onDelete: SetNull)
  guests                BookingGuest[]
  history               BookingHistory[]
  roomStatusHistory     RoomStatusHistory[]
  qrTokens              BookingQrToken[]
  qrScanLogs            QrScanLog[]
  guestRegister         GuestRegister?
  review                Review?

  @@index([pilgrimUserId])
  @@index([lodgeId, status])
  @@index([roomTypeId])
  @@index([roomId])
  @@index([cityId])
  @@index([checkInDate, checkOutDate])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([cityId, createdAt])
  @@index([ownerResponseDeadline])
  @@index([deletedAt])
  @@map("bookings")
}

model BookingGuest {
  id                  String       @id @default(uuid()) @db.Uuid
  bookingId           String       @map("booking_id") @db.Uuid
  fullName            String       @map("full_name")
  age                 Int?
  gender              String?
  phone               String?
  idType              GuestIdType? @map("id_type")
  idNumber            String?      @map("id_number")
  idProofStoragePath  String?      @map("id_proof_storage_path")
  idProofOriginalName String?      @map("id_proof_original_name")
  idProofMimeType     String?      @map("id_proof_mime_type")
  idProofSizeBytes    Int?         @map("id_proof_size_bytes")
  isPrimaryGuest      Boolean      @default(false) @map("is_primary_guest")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  deletedAt           DateTime?    @map("deleted_at")
  booking             Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([deletedAt])
  @@map("booking_guests")
}

model BookingLock {
  id            String            @id @default(uuid()) @db.Uuid
  lockCode      String            @unique @map("lock_code")
  pilgrimUserId String?           @map("pilgrim_user_id") @db.Uuid
  lodgeId       String            @map("lodge_id") @db.Uuid
  roomTypeId    String            @map("room_type_id") @db.Uuid
  roomId        String?           @map("room_id") @db.Uuid
  checkInDate   DateTime          @map("check_in_date") @db.Date
  checkOutDate  DateTime          @map("check_out_date") @db.Date
  expiresAt     DateTime          @map("expires_at")
  status        BookingLockStatus @default(ACTIVE)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  pilgrim       User?             @relation(fields: [pilgrimUserId], references: [id], onDelete: SetNull)
  lodge         Lodge             @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  roomType      RoomType          @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  room          Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)

