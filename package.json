{
  "name": "tuljai-stays",
  "version": "0.1.0",
  "private": true,
  "description": "Tuljai Stays monorepo for pilgrim, owner, admin, and backend applications.",
  "license": "MIT",
  "packageManager": "npm@10.8.0",
  "workspaces": [
    "apps/*",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspace @tuljai/types && npm run build --workspace @tuljai/utils && npm run build --workspace @tuljai/shared && npm run build --workspace @tuljai/ui && npm run build --workspace @tuljai/admin-panel && npm run build --workspace @tuljai/backend",
    "build:admin": "npm --workspace @tuljai/admin-panel run build",
    "build:backend": "npm --workspace @tuljai/backend run build",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run build --workspace @tuljai/utils && npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\"",
    "postinstall": "patch-package",
    "verify:workspace": "node scripts/verify-workspace.mjs",
    "db:generate": "npm --workspace @tuljai/backend run db:generate",
    "db:deploy": "npm --workspace @tuljai/backend run db:deploy",
    "db:migrate": "npm --workspace @tuljai/backend run db:migrate",
    "db:seed": "npm --workspace @tuljai/backend run db:seed",
    "db:studio": "npm --workspace @tuljai/backend run db:studio",
    "start:admin": "npm --workspace @tuljai/admin-panel run start",
    "start:backend": "npm --workspace @tuljai/backend run start"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "expo": "~57.0.9",
    "expo-dev-client": "57.0.10",
    "expo-router": "~57.0.9",
    "patch-package": "^8.0.0",
    "prettier": "^3.6.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0"
  },
  "overrides": {
    "expo-dev-client": "57.0.10",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  }
}
