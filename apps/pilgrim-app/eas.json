{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://tuljai-stays-backend.onrender.com/api",
        "EXPO_PUBLIC_USE_MOCKS": "false"
      }
    },
    "preview": {
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://tuljai-stays-backend.onrender.com/api",
        "EXPO_PUBLIC_USE_MOCKS": "false"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://tuljai-stays-backend.onrender.com/api",
        "EXPO_PUBLIC_USE_MOCKS": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
