{
  "expo": {
    "name": "Tuljai Stays",
    "slug": "tuljai-stays-pilgrim",
    "scheme": "tuljai-stays",
    "icon": "./assets/icon.png",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.tuljaistays.pilgrim",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#C95516",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "ios": {
      "bundleIdentifier": "com.tuljaistays.pilgrim",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F24A00",
          "image": "./assets/splash-screen.png",
          "imageWidth": 288,
          "resizeMode": "cover"
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#C95516",
          "defaultChannel": "general-v1",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ea095b95-27bb-4c76-8ad2-ddf7ab8ba614"
      }
    }
  }
}
