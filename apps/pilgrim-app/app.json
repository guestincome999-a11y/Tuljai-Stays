{
  "expo": {
    "name": "Tuljai Stays",
    "slug": "tuljai-stays-pilgrim",
    "scheme": "tuljai-stays",
    "icon": "./assets/icon.png",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ea095b95-27bb-4c76-8ad2-ddf7ab8ba614",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "android": {
      "package": "com.tuljaistays.pilgrim",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#800D32",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "ios": {
      "bundleIdentifier": "com.tuljaistays.pilgrim",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#590923",
          "image": "./assets/splash-screen.png",
          "imageWidth": 288,
          "resizeMode": "cover"
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#800D32",
          "defaultChannel": "general-v1",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-web-browser",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Tuljai Stays to save your stay pass to your photos.",
          "savePhotosPermission": "Allow Tuljai Stays to save your stay pass to your photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ea095b95-27bb-4c76-8ad2-ddf7ab8ba614"
      }
    }
  }
}
