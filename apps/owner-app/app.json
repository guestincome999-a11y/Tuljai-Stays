{
  "expo": {
    "name": "Tuljai Stays Owner",
    "owner": "jay9529",
    "slug": "tuljai-stays-owner",
    "scheme": "tuljaistays-owner",
    "icon": "./assets/icon.png",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.tuljaistays.owner",
      "infoPlist": {
        "NSCameraUsageDescription": "Tuljai Stays Owner uses the camera to scan pilgrim QR passes for secure check-in.",
        "NSPhotoLibraryUsageDescription": "Tuljai Stays Owner needs access to your photos so you can upload lodge and room photos."
      },
      "supportsTablet": true
    },
    "android": {
      "package": "com.tuljaistays.owner",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#861632",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "versionCode": 24
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5C1024",
          "image": "./assets/owner-temple-login.png",
          "imageWidth": 288,
          "resizeMode": "cover"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#861632",
          "defaultChannel": "general-v1",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-camera",
        {
          "barcodeScannerEnabled": true,
          "cameraPermission": "Allow Tuljai Stays Owner to use the camera for pilgrim QR check-in.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tuljai Stays Owner to access your photos so you can upload lodge and room photos."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e698d5d7-6619-4881-ae1d-75a76661046b"
      }
    }
  }
}
