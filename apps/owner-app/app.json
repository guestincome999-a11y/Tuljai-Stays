{
  "expo": {
    "name": "Tuljai Stays Owner",
    "slug": "tuljai-stays-owner",
    "scheme": "tuljaistays-owner",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
