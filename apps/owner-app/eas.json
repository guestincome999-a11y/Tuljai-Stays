{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://tuljai-stays-backend.onrender.com/api",
        "EXPO_PUBLIC_OWNER_PREVIEW_PHONE": "9876500001"
      }
    },
    "preview": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://tuljai-stays-backend.onrender.com/api",
        "EXPO_PUBLIC_OWNER_PREVIEW_PHONE": "9876500001"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://tuljai-stays-backend.onrender.com/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
