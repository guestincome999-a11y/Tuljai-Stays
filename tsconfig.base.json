{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@tuljai/shared": ["packages/shared/src/index.ts"],
      "@tuljai/types": ["packages/types/src/index.ts"],
      "@tuljai/ui": ["packages/ui/src/index.ts"],
      "@tuljai/utils": ["packages/utils/src/index.ts"]
    }
  }
}
